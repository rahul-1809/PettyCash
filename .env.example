# Runtime
APP_ENV=development
PORT=8000

# Persistence
# Leave empty for local SQLite. Use a PostgreSQL connection string in production.
DATABASE_URL=

# CORS
# Use a comma-separated list in production; do not use "*" with credentials.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Future operational settings
LOG_LEVEL=INFO
UPLOAD_MAX_BYTES=10485760

# SMTP onboarding and notification delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

